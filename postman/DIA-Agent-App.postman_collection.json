                "});",
                "pm.test('Status is queued', function () {",
                "    pm.expect(pm.response.json().status).to.eql('queued');",
                "});"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/ingest_document", "host": ["{{baseUrl}}"], "path": ["ingest_document"] },
