{
  "info": {
    "_postman_id": "dia-agent-app-v1",
    "name": "DIA — DronaPay Intelligent Agent",
    "description": "Complete test collection for the DIA FastAPI service.\n\n**Setup:**\n1. Set `baseUrl` to your running instance (default: http://localhost:8000)\n2. Set `username` / `password` to match REST_USER / REST_PWD in your .env\n3. Set `tenantId` (seed data uses 17)\n4. Run the **Setup** folder first to initialise collection variables\n\n**Auth:** HTTP Basic is applied at collection level — all requests inherit it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:8000", "type": "string" },
    { "key": "username",   "value": "admin",                 "type": "string" },
    { "key": "password",   "value": "changeme",              "type": "string" },
    { "key": "tenantId",   "value": "17",                    "type": "string" },
    { "key": "documentId", "value": "",                      "type": "string",
      "description": "Set by POST /ingest_document test script" },
    { "key": "versionId",  "value": "",                      "type": "string",
      "description": "Set by POST /ingest_document test script" },
    { "key": "internalSecret", "value": "test-internal-secret", "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 Authentication",
      "description": "Verify that endpoints enforce HTTP Basic auth.",
      "item": [
        {
          "name": "Valid credentials — should pass (200 or 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentid\": \"nonexistent_agent\",\n  \"data\": {}\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Valid credentials not rejected', function () {",
              "    pm.expect(pm.response.code).to.not.equal(401);",
              "    pm.expect(pm.response.code).to.not.equal(403);",
              "});"
            ]}
          }]
        },
        {
          "name": "No credentials — 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": { "mode": "raw", "raw": "{\"agentid\": \"userManual\", \"data\": {}}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('No auth returns 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]}
          }]
        },
        {
          "name": "Wrong credentials — 401",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "wrong_user", "type": "string" },
                { "key": "password", "value": "wrong_pass", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": { "mode": "raw", "raw": "{\"agentid\": \"userManual\", \"data\": {}}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Wrong credentials return 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]}
          }]
        }
      ]
    },

    {
      "name": "🤖 Agent — Run",
      "description": "POST /agent for each configured agent.\n\nAll agents require `itenantid` in input_data. Prerequisites (DB lookups) run first; similar cases are retrieved from PGVector; LLM generates the final response.",
      "item": [
        {
          "name": "caseagentv1 — Fraud case analysis",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentid\": \"caseagentv1\",\n  \"data\": {\n    \"RuleSpecificL1Action\": \"FLAG\",\n    \"RuleID\": \"4231\",\n    \"CaseID\": \"TXN-9182736\",\n    \"BatchDate\": \"2024-03-15\",\n    \"itenantid\": {{tenantId}},\n    \"iaccountid\": 10001,\n    \"icustomerid\": 20001\n  }\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has decision or comment', function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body).to.have.any.keys(['decision', 'comment', 'answer']);",
              "});",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "});"
            ]}
          }]
        },
        {
          "name": "userManual — Help query",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentid\": \"userManual\",\n  \"data\": {\n    \"itenantid\": {{tenantId}},\n    \"user_query\": \"How do I configure a payment rule in DronaPay?\"\n  }\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has answer', function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body).to.have.property('answer');",
              "    pm.expect(body.answer).to.be.a('string');",
              "    pm.expect(body.answer.length).to.be.above(0);",
              "});"
            ]}
          }]
        },
        {
          "name": "userManual — Off-topic query (tests guardrails)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentid\": \"userManual\",\n  \"data\": {\n    \"itenantid\": {{tenantId}},\n    \"user_query\": \"What is the capital of France?\"\n  }\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200 — out-of-scope handled gracefully', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Has answer field', function () {",
              "    pm.expect(pm.response.json()).to.have.property('answer');",
              "});"
            ]}
          }]
        },
        {
          "name": "rulesDev — Create new rule",
