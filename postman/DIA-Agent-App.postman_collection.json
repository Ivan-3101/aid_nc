    {
      "name": "📤 DMS — Ingest Document",
      "description": "POST /ingest_document\n\nReturns {status: 'queued'} immediately. Actual processing runs in a background task — poll GET /document_status to track progress.\n\nFile sources:\n- raw_text: plain text, processed directly\n- file_content: base64-encoded binary, stored in agents.dms_file_content (no S3/GCS needed)\n- storage_url: URL on ALLOWED_STORAGE_ORIGINS allowlist",
      "item": [
        {
          "name": "UserManual — raw_text (happy path)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Generate new UUIDs for each run",
                "var uuid1 = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                "    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                "    return v.toString(16);",
                "});",
                "var uuid2 = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                "    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                "    return v.toString(16);",
                "});",
                "pm.collectionVariables.set('documentId', uuid1);",
                "pm.collectionVariables.set('versionId', uuid2);"
              ]}
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Status is queued', function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body.status).to.eql('queued');",
                "});",
                "pm.test('document_id echoed back', function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body.document_id).to.eql(pm.collectionVariables.get('documentId'));",
                "});",
                "pm.test('version_id echoed back', function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body.version_id).to.eql(pm.collectionVariables.get('versionId'));",
                "});"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/ingest_document", "host": ["{{baseUrl}}"], "path": ["ingest_document"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{documentId}}\",\n  \"version_id\":  \"{{versionId}}\",\n  \"itenantid\":   {{tenantId}},\n  \"doctype\":     \"UserManual\",\n  \"file_type\":   \"txt\",\n  \"raw_text\":    \"DronaPay user manual: to configure a payment rule go to Rules > Configuration.\",\n  \"sha256_hash\": \"78c5dda5f5d5e5513b15d7a3777f207227892583c73716cedd881fb32862002d\"\n}"
            }
          }
        },
        {
          "name": "PolicyDocument — file_content base64 (no storage URL needed)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "var uuid1 = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                "    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                "    return v.toString(16);",
                "});",
                "var uuid2 = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                "    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                "    return v.toString(16);",
