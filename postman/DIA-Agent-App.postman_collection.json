            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentid\": \"rulesDev\",\n  \"data\": {\n    \"itenantid\": {{tenantId}},\n    \"user_query\": \"Create a rule to flag transactions above 50000 INR from merchants with less than 30 days of activity.\",\n    \"rule_expectation\": \"Flag high-value transactions from new unverified merchants.\"\n  }\n}"
