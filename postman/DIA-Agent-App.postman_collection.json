        {
          "name": "orchestratorAgent — Route user query",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentid\": \"orchestratorAgent\",\n  \"data\": {\n    \"itenantid\": {{tenantId}},\n    \"iuserid\": 42,\n    \"user_query\": \"How do I add a new fraud detection rule?\"\n  }\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Orchestrator routes or answers', function () {",
              "    var body = pm.response.json();",
              "    var hasRouting = body.agentid !== undefined && body.data !== undefined;",
              "    var hasAnswer  = body.answer !== undefined;",
              "    pm.expect(hasRouting || hasAnswer).to.be.true;",
              "});"
            ]}
          }]
        },
        {
          "name": "Unknown agent — 404",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/agent", "host": ["{{baseUrl}}"], "path": ["agent"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentid\": \"agent_that_does_not_exist\",\n  \"data\": { \"itenantid\": {{tenantId}} }\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Unknown agent returns 404', function () {",
              "    pm.response.to.have.status(404);",
