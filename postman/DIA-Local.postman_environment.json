{
  "id": "dia-local-env",
  "name": "DIA — Local",
  "values": [
    {
      "key":     "baseUrl",
      "value":   "http://localhost:8000",
      "enabled": true,
      "type":    "default"
    },
    {
      "key":     "username",
      "value":   "admin",
      "enabled": true,
      "type":    "default",
      "_note":   "Must match REST_USER in your .env file"
    },
    {
      "key":     "password",
      "value":   "changeme",
      "enabled": true,
      "type":    "secret",
      "_note":   "Must match REST_PWD in your .env file"
    },
    {
      "key":     "tenantId",
      "value":   "17",
      "enabled": true,
      "type":    "default",
      "_note":   "Tenant 17 is pre-seeded in the SQL scripts"
    },
    {
      "key":     "documentId",
      "value":   "",
      "enabled": true,
      "type":    "any",
      "_note":   "Auto-set by ingest tests — leave blank"
    },
    {
      "key":     "versionId",
      "value":   "",
      "enabled": true,
      "type":    "any",
      "_note":   "Auto-set by ingest tests — leave blank"
    },
    {
      "key":     "internalSecret",
      "value":   "test-internal-secret",
      "enabled": true,
      "type":    "secret",
      "_note":   "Must match INTERNAL_API_SECRET in your .env file"
    }
  ],
  "_postman_variable_scope": "environment",
  "description": "Local development environment for DIA agent app running at http://localhost:8000.\n\nSet username / password / internalSecret to match your .env values."
}
